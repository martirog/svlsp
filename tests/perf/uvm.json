{
  "name": "uvm",
  "description": "A user testbench (uvm_perf_tb.sv) on top of the full UVM library DB.",
  "vars": {
    "UVM_DB": {
      "env": "SVLSP_UVM_DB",
      "default": "/home/martin/src/verilator_test/uvm-core/src/uvm.db",
      "mustExist": true
    }
  },
  "files": { "uvm_perf_tb.sv": "tests/perf/uvm_perf_tb.sv" },
  "write": {
    ".svlsp.json": { "files": ["uvm_perf_tb.sv"], "libraryDbs": ["${UVM_DB}"] }
  },
  "open": "uvm_perf_tb.sv",
  "ready": { "at": { "find": "probe-lib: uvm_comp", "offset": "end" }, "label": "uvm_component" },
  "requests": [
    { "name": "completion: library class prefix (uvm_comp)", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-lib: uvm_comp", "offset": "end" } },
    { "name": "completion: inherited prefix (get_)", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-prefix: get_", "offset": "end" } },
    { "name": "completion: empty prefix in a method", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-empty:", "offset": "end" } },
    { "name": "completion: dot on a library-typed member", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-dot: perf_peer.", "offset": "end" } },
    { "name": "completion: chained call dot", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-chain: this.get_parent().", "offset": "end" } },
    { "name": "completion: dot from a module", "method": "textDocument/completion",
      "tier": "keystroke", "at": { "find": "probe-outside: env.", "offset": "end" } },
    { "name": "completionItem/resolve (doc of get_full_name)", "method": "completionItem/resolve",
      "tier": "keystroke", "resolveFrom": { "at": { "find": "probe-prefix: get_", "offset": "end" },
                                            "label": "get_full_name" } },
    { "name": "signatureHelp: library method lookup(", "method": "textDocument/signatureHelp",
      "tier": "keystroke", "at": { "find": "lookup(\"child\")", "offset": 7 } },
    { "name": "signatureHelp: super.new(", "method": "textDocument/signatureHelp",
      "tier": "keystroke", "at": { "find": "super.new(name", "offset": 10 } },
    { "name": "hover: library class", "method": "textDocument/hover",
      "tier": "point", "at": { "find": "extends uvm_component", "sub": "uvm_component" } },
    { "name": "hover: inherited library method", "method": "textDocument/hover",
      "tier": "point", "at": { "find": "perf_peer.get_full_name", "sub": "get_full_name" } },
    { "name": "hover: local member", "method": "textDocument/hover",
      "tier": "point", "at": { "find": "perf_count = ", "sub": "perf_count" } },
    { "name": "hover: library macro", "method": "textDocument/hover",
      "tier": "point", "at": { "find": "`uvm_info(\"PERF\"", "offset": 2 } },
    { "name": "definition: inherited library method", "method": "textDocument/definition",
      "tier": "point", "at": { "find": "perf_peer.get_num_children", "sub": "get_num_children" } },
    { "name": "definition: library type", "method": "textDocument/definition",
      "tier": "point", "at": { "find": "build_phase(uvm_phase", "sub": "uvm_phase" } },
    { "name": "documentSymbol", "method": "textDocument/documentSymbol", "tier": "point" },
    { "name": "references: local member", "method": "textDocument/references",
      "tier": "navigation", "at": { "find": "perf_count = ", "sub": "perf_count" },
      "params": { "context": { "includeDeclaration": true } } },
    { "name": "references: library method (get_full_name)", "method": "textDocument/references",
      "tier": "navigation", "at": { "find": "perf_peer.get_full_name", "sub": "get_full_name" },
      "params": { "context": { "includeDeclaration": true } } },
    { "name": "rename: local member", "method": "textDocument/rename",
      "tier": "navigation", "at": { "find": "perf_count = ", "sub": "perf_count" },
      "params": { "newName": "perf_total" } },
    { "name": "workspace/symbol: uvm_comp", "method": "workspace/symbol",
      "tier": "navigation", "params": { "query": "uvm_comp" } },
    { "name": "workspace/symbol: get_name", "method": "workspace/symbol",
      "tier": "navigation", "params": { "query": "get_name" } }
  ],
  "edit": { "at": { "find": "perf_count++;", "offset": "end" }, "text": " " },
  "typing": { "at": { "find": "perf_count++;", "offset": "end" },
              "text": "\n      perf_peer.get_fu" }
}
